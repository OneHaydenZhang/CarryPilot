# ---- 网络（mainnet-first，本项目按正式网标准处理）----
NETWORK=mainnet                 # mainnet | testnet，全局唯一开关
INJECTIVE_NETWORK=mainnet

# ---- LLM ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# ---- 积分（INJ 充值）----
INJ_TREASURY_ADDRESS=        # 平台金库（inj1... 或 0x...），未配置则仅体验积分
POINTS_RATE_INJ=100          # 1 INJ = 100 积分
POINTS_PER_TICK=0.2          # 每个 Agent 决策 tick 消耗
POINTS_WELCOME=500           # 新用户赠送

# ---- Hyperliquid ----
# 主账户地址（查询用），API wallet 私钥（签名用）——注意：查询传主账户地址，签名用 agent key
HL_ACCOUNT_ADDRESS=
HL_API_WALLET_PRIVATE_KEY=

# ---- Injective ----
INJ_PRIVATE_KEY=
